# Optional. The core analysis works without an OpenAI key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Optional locally; required on App Runner for persistent rooms.
CONSENSUS_TABLE_NAME=consensus-rooms

# Google 로그인: OAuth 2.0 "웹 애플리케이션" Client ID만 사용합니다.
# Client Secret은 이 ID-token 로그인 흐름에 필요하지 않습니다.
GOOGLE_CLIENT_ID=
# 최소 32자. 운영에서는 `openssl rand -hex 32` 등으로 별도 생성합니다.
SESSION_SECRET=
# localhost=false, HTTPS 운영 서버=true
SESSION_COOKIE_SECURE=false
# 기본 7일, 허용 범위 5분~30일
SESSION_TTL_SECONDS=604800
# 프런트와 API가 다른 origin일 때만 쉼표로 추가합니다.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
