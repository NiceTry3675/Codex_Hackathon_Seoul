# Copy needed entries into your ignored .env or deployment environment.
# Never commit real tokens. Existing Slack deployment settings remain valid.
SLACK_BOT_TOKEN=
# Bot User OAuth Token from OAuth & Permissions, beginning with xoxb-.
SLACK_SIGNING_SECRET=
# Signing Secret from Basic Information.
SLACK_TEAM_ID=
# Workspace ID from this bot's auth.test response, beginning with T.
SYNQ_PUBLIC_URL=https://YOUR_HOST
# HTTPS origin only, without a path, query, or fragment.
# Compatibility alias when SYNQ_PUBLIC_URL is not set:
# SLACK_PUBLIC_BASE_URL=https://YOUR_HOST

# Optional App ID allowlist from Basic Information, beginning with A.
# SLACK_APP_ID=
SLACK_HISTORY_RETENTION_DAYS=90
# 7..365 days for private history; public room/submission expiry is unchanged.

# Reuse the existing Google login settings for explicit account linking.
GOOGLE_CLIENT_ID=
SESSION_SECRET=
# Stable server-only random secret of at least 32 characters.
SESSION_COOKIE_SECURE=true
# Use false only for direct local HTTP development.
SESSION_TTL_SECONDS=604800

# Reuse existing server AI settings for thread drafts and opinion processing.
OPENAI_API_KEY=
# Keep your existing OPENAI_MODEL and OPENAI_TIMEOUT_SECONDS settings.

# Reuse the existing DynamoDB table (partition key code, TTL expires_at).
CONSENSUS_TABLE_NAME=
AWS_DEFAULT_REGION=ap-northeast-1
# A blank table uses process memory for development; restart loses that data.
# AWS credentials come from the existing runtime role or local profile.
