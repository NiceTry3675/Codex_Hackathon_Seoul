# Copy the relevant entries into your ignored local .env or deployment secrets.
# Never paste real tokens into this tracked example or commit them.
SLACK_BOT_TOKEN=
# Bot User OAuth Token from OAuth & Permissions, beginning with xoxb-.
SLACK_SIGNING_SECRET=
# Signing Secret from Basic Information (at least 32 characters).
SLACK_TEAM_ID=
# Workspace ID beginning with T, e.g. the T... segment in Slack's browser URL.
SLACK_APP_ID=
# App ID beginning with A, from Basic Information.
SLACK_PUBLIC_BASE_URL=https://YOUR_HOST
SLACK_HISTORY_RETENTION_DAYS=90
# Allowed retention: 7..365 days. Controls Slack history, not legacy room TTL.

# Reuse existing Google auth settings; exact browser origin must be authorized.
GOOGLE_CLIENT_ID=
SESSION_SECRET=
# Random server-only secret of at least 32 characters; keep stable across restarts.
SESSION_COOKIE_SECURE=true
# Use false only for direct local http://localhost or http://127.0.0.1 testing.
SESSION_TTL_SECONDS=604800

# Reuse the existing DynamoDB table (partition key code, TTL expires_at).
CONSENSUS_TABLE_NAME=
AWS_DEFAULT_REGION=ap-northeast-1
# Blank table uses process memory, for local development only.
# AWS credentials must come from the existing runtime role or your local profile.
# OPENAI_API_KEY remains optional; statistical results work without it.
