{
  "display_information": {
    "name": "SynQ",
    "description": "스레드에서 결정을 만들고, 평가와 내 참여 기록을 확인합니다.",
    "background_color": "#3b5e48"
  },
  "features": {
    "bot_user": {
      "display_name": "SynQ",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/synq",
        "url": "https://YOUR_HOST/api/slack/commands",
        "description": "결정 만들기, 평가 참여와 내 기록",
        "usage_hint": "new | from THREAD_LINK | join CODE | rooms | link",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": ["commands", "chat:write", "channels:history"]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://YOUR_HOST/api/slack/interactions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
